
# Used to encrypt JWT tokens
#DATABASE_URL="postgres://postgres:punyatailakoti@db.dvjirzgoedmgofrmxwwj.supabase.co:6543/postgres"
DATABASE_URL="postgres://postgres:punyatailakoti@db.dvjirzgoedmgofrmxwwj.supabase.co:6543/postgres"
PAYLOAD_SECRET=e3210d784ecd91d5efdbc9fc
# Recommended `true` for `next dev`: Drizzle push can open interactive enum prompts and block
# every request when there is no TTY. After `supabase db reset` or when you need a one-off sync,
# set to `false`, restart dev once, then set back to `true`.
# One-off sync without starting Next: `pnpm payload:db-sync` (see package.json).
PAYLOAD_DISABLE_DB_PUSH=true

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ── Razorpay ────────────────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ── Resend (email & newsletter) ──────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_AUDIENCE_ID=YOUR_AUDIENCE_ID

# ── Supabase local ([db].port in supabase/config.toml; must not equal [studio].port) ──
# postgresql://postgres:postgres@127.0.0.1:54325/postgres?sslmode=disable
