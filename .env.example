
# Used to encrypt JWT tokens
#DATABASE_URL="postgres://postgres:punyatailakoti@db.dvjirzgoedmgofrmxwwj.supabase.co:6543/postgres"
DATABASE_URL="postgres://postgres:punyatailakoti@db.dvjirzgoedmgofrmxwwj.supabase.co:6543/postgres"
PAYLOAD_SECRET=e3210d784ecd91d5efdbc9fc
# Recommended `true` for `next dev`: Drizzle push can open interactive enum prompts and block
# every request when there is no TTY. After `supabase db reset` or when you need a one-off sync,
# set to `false`, restart dev once, then set back to `true`.
# One-off sync without starting Next: `pnpm payload:db-sync` (see package.json).
PAYLOAD_DISABLE_DB_PUSH=true

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# ── Razorpay ────────────────────────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# ── Resend (email & newsletter) ──────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_AUDIENCE_ID=YOUR_AUDIENCE_ID

# ── Supabase (Auth for storefront + Postgres for Payload) ─────────────────
# Google OAuth is configured on the cloud project — use these for local dev too:
NEXT_PUBLIC_SUPABASE_URL=https://dvjirzgoedmgofrmxwwj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_from_dashboard
# Pure local Supabase (phone OTP test numbers only): http://127.0.0.1:54321 + keys from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google OAuth (optional locally — enable in supabase/config.toml when set)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Twilio for production phone OTP (Supabase Dashboard → Auth → Phone)
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# Database — local ([db].port in supabase/config.toml; must not equal [studio].port)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54325/postgres?sslmode=disable
# Cloud: Session pooler URI from Supabase Dashboard → Connect

# ── ImageKit (media hosting) ────────────────────────────────────────────────
# https://imagekit.io/dashboard/developer/api-keys
# IMAGEKIT_FOLDER is the project root inside ImageKit (e.g. /punyakoti-taila).
# All uploads from Payload admin land under this folder, in the sub-folder
# selected on the Media doc.
IMAGEKIT_PUBLIC_KEY=public_YOUR_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
IMAGEKIT_FOLDER=/punyakoti-taila
