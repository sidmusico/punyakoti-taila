
# Copy to `.env` for local development. Set the same keys in Vercel → Environment Variables for production.
# See doc/DEPLOY_VERCEL.md for the full deploy checklist.

# ── Database (Payload CMS) ─────────────────────────────────────────────────
# Local dev (used by `next dev` / `pnpm db:sync` → local)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54325/postgres?sslmode=disable
# Production pooler — used by `pnpm db:sync` → prod (Session pooler, port 5432)
DATABASE_URL_PROD=postgresql://postgres.[project-ref]:[password]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require

PAYLOAD_SECRET=generate_a_long_random_string
# Recommended `true` for `next dev` and required on Vercel (no interactive Drizzle push at runtime).
PAYLOAD_DISABLE_DB_PUSH=true

# Canonical public URL — no trailing slash. Drives Supabase OAuth `redirectTo`, CORS, sitemaps.
# Local dev:
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Production (set on Vercel → Environment Variables — required for Google SSO on prod):
# NEXT_PUBLIC_SERVER_URL=https://punyakoti-taila.vercel.app

# Protects seed/sync APIs in production (see doc/SEED_APIS.md)
CRON_SECRET=generate_a_long_random_string

# Payload live preview
PREVIEW_SECRET=generate_a_long_random_string

# ── Razorpay (Standard Checkout) ────────────────────────────────────────────
# Server-only — never expose KEY_SECRET to the browser.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# Optional: same KEY_ID for client (falls back to RAZORPAY_KEY_ID if unset).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
# Optional: Dashboard checkout configuration (enables UPI order on the account).
# RAZORPAY_CHECKOUT_CONFIG_ID=config_...
# Optional: hide cards on live checkout (default: cards hidden automatically for rzp_test_* keys).
# NEXT_PUBLIC_RAZORPAY_HIDE_CARDS=true

# ── Resend (email & newsletter) ──────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# Verified sender in Resend (required for production deliverability)
RESEND_FROM=Punyakoti Taila <orders@yourdomain.com>
RESEND_AUDIENCE_ID=YOUR_AUDIENCE_ID

# ── Supabase Auth (storefront login) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://dvjirzgoedmgofrmxwwj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_from_dashboard
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: Supabase Auth Send Email hook → POST /api/auth/hook/send-email (uses Payload email templates + Resend)
# SUPABASE_AUTH_HOOK_SECRET=generate_a_long_random_string
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── ImageKit (media hosting) ─────────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_YOUR_PUBLIC_KEY
IMAGEKIT_PRIVATE_KEY=private_YOUR_PRIVATE_KEY
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID
IMAGEKIT_FOLDER=/punyakoti-taila
